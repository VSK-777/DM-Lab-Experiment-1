      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Dimension lookup/update (Date &amp; Facility)</from>
      <to>Table output (Fact_Patient_Visit)</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>CSV file input (patient_visits)</name>
    <type>CsvInput</type>
    <description>Extracts raw clinical encounters from CSV</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${Internal.Entry.Current.Directory}/../data/patient_visits.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>Y</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <format>mixed</format>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>visit_id</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>20</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>patient_id</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>20</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
