      <attribute><code>USE_POOLING</code><attribute>N</attribute></attribute>
    </attributes>
  </connection>
  <order>
    <hop>
      <from>CSV file input (patient_visits)</from>
      <to>Select values (Cleanse &amp; Format)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select values (Cleanse &amp; Format)</from>
      <to>Value mapper (Standardize)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Value mapper (Standardize)</from>
