<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>Healthcare_Patient_Visit_ETL</name>
    <description>Pentaho Data Integration visual ETL workflow for DM Lab Experiment 1</description>
    <extended_description>Extracts patient visits from CSV, standardizes values, resolves dimension keys, and loads into MySQL Fact_Patient_Visit</extended_description>
    <trans_version>1.0</trans_version>
    <trans_type>Normal</trans_type>
    <trans_status>0</trans_status>
    <directory>/</directory>
