        <format>#</format>
        <currency/>
        <decimal/>
        <group/>
        <length>5</length>
        <precision>0</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
