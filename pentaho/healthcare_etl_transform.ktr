        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>20</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>visit_date</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>20</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>diagnosis</name>
